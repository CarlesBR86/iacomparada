---
import { AFILIADOS } from '../../data/afiliados';

export function getStaticPaths() {
  return Object.entries(AFILIADOS).map(([slug, a]) => ({ params: { slug }, props: a }));
}
const { nombre, url } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${url}`} />
    <link rel="canonical" href={url} />
    <title>Redirigiendo a {nombre}…</title>
  </head>
  <body>
    <p>Redirigiendo a <a href={url} rel="sponsored nofollow">{nombre}</a>…</p>
  </body>
</html>
